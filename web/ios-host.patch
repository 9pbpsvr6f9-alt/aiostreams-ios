diff --git a/packages/web/src/components/shell/ios-backdrop.tsx b/packages/web/src/components/shell/ios-backdrop.tsx
new file mode 100644
index 00000000..d6ab3c10
--- /dev/null
+++ b/packages/web/src/components/shell/ios-backdrop.tsx
@@ -0,0 +1,273 @@
+import React from 'react';
+import { settings, useSetting } from '@/lib/settings';
+
+/** The hero's slide on show, and its newest picture. */
+const HERO_PICTURE =
+  "[data-ui='hero-backdrops'] > [data-slide='0'] img[data-ui='hero-backdrop']";
+/** Pixels across the first, heavy blur: small, so it costs next to nothing. */
+const SOFT_WIDTH = 64;
+/**
+ * Pixels across what the page stretches over the screen: the small blur enlarged smoothly and
+ * blurred again here, as a 64-pixel picture stretched thirty times over shows its pixels as blocks.
+ */
+const SHOWN_WIDTH = 256;
+
+function pictureOf(img: HTMLImageElement | null | undefined): string | null {
+  return (img && (img.currentSrc || img.src)) || null;
+}
+
+/** One pass of a box blur of `radius` along rows (`horizontal`) or columns, in place. */
+function boxPass(
+  data: Uint8ClampedArray,
+  width: number,
+  height: number,
+  radius: number,
+  horizontal: boolean
+) {
+  const lines = horizontal ? height : width;
+  const length = horizontal ? width : height;
+  const line = new Float32Array(length * 3);
+  for (let l = 0; l < lines; l++) {
+    const at = (i: number) =>
+      (horizontal ? l * width + i : i * width + l) * 4;
+    for (let i = 0; i < length; i++) {
+      let r = 0;
+      let g = 0;
+      let b = 0;
+      for (let k = -radius; k <= radius; k++) {
+        const p = at(Math.min(length - 1, Math.max(0, i + k)));
+        r += data[p];
+        g += data[p + 1];
+        b += data[p + 2];
+      }
+      const n = radius * 2 + 1;
+      line[i * 3] = r / n;
+      line[i * 3 + 1] = g / n;
+      line[i * 3 + 2] = b / n;
+    }
+    for (let i = 0; i < length; i++) {
+      const p = at(i);
+      data[p] = line[i * 3];
+      data[p + 1] = line[i * 3 + 1];
+      data[p + 2] = line[i * 3 + 2];
+    }
+  }
+}
+
+/** A softened picture, and its size in pixels. */
+interface Soft {
+  url: string;
+  width: number;
+  height: number;
+}
+
+const softened = new Map<string, Promise<Soft | null>>();
+
+/**
+ * The picture shrunk to SOFT_WIDTH pixels and box-blurred there, as a data URL: the blur is done
+ * once on a picture this small, which costs next to nothing, where a CSS blur over the whole screen
+ * would be drawn again as the page scrolls over it.
+ */
+function soften(src: string): Promise<Soft | null> {
+  let known = softened.get(src);
+  if (!known) {
+    known = (async () => {
+      try {
+        const response = await fetch(src);
+        if (!response.ok) return null;
+        const bitmap = await createImageBitmap(await response.blob());
+        const width = SOFT_WIDTH;
+        const height = Math.max(
+          1,
+          Math.round((SOFT_WIDTH * bitmap.height) / bitmap.width)
+        );
+        const canvas = document.createElement('canvas');
+        canvas.width = width;
+        canvas.height = height;
+        const context = canvas.getContext('2d');
+        if (!context) return null;
+        context.drawImage(bitmap, 0, 0, width, height);
+        bitmap.close();
+        const image = context.getImageData(0, 0, width, height);
+        for (let pass = 0; pass < 3; pass++) {
+          boxPass(image.data, width, height, 4, true);
+          boxPass(image.data, width, height, 4, false);
+        }
+        context.putImageData(image, 0, 0);
+        const shown = document.createElement('canvas');
+        shown.width = SHOWN_WIDTH;
+        shown.height = Math.max(1, Math.round((SHOWN_WIDTH * height) / width));
+        const big = shown.getContext('2d');
+        if (!big) return null;
+        big.imageSmoothingEnabled = true;
+        big.imageSmoothingQuality = 'high';
+        big.drawImage(canvas, 0, 0, shown.width, shown.height);
+        const smooth = big.getImageData(0, 0, shown.width, shown.height);
+        for (let pass = 0; pass < 2; pass++) {
+          boxPass(smooth.data, shown.width, shown.height, 6, true);
+          boxPass(smooth.data, shown.width, shown.height, 6, false);
+        }
+        // Richer colour, as a frosted wash shows it.
+        const px = smooth.data;
+        for (let i = 0; i < px.length; i += 4) {
+          const grey = 0.299 * px[i] + 0.587 * px[i + 1] + 0.114 * px[i + 2];
+          px[i] = grey + (px[i] - grey) * 1.4;
+          px[i + 1] = grey + (px[i + 1] - grey) * 1.4;
+          px[i + 2] = grey + (px[i + 2] - grey) * 1.4;
+        }
+        big.putImageData(smooth, 0, 0);
+        return {
+          url: shown.toDataURL('image/jpeg', 0.9),
+          width: shown.width,
+          height: shown.height,
+        };
+      } catch {
+        return null;
+      }
+    })();
+    softened.set(src, known);
+    // A few dozen at most: the hero turns through a handful, and cards come and go.
+    if (softened.size > 40) softened.delete(softened.keys().next().value!);
+  }
+  return known;
+}
+
+/**
+ * iOS: a frosted background behind the pages (Settings > Interface > Background), softened and
+ * dimmed: on Home the hero's picture, crossfading as the hero turns; on a title's or collection's
+ * page its own picture. Other pages keep the plain colour.
+ */
+export function IosBackdrop() {
+  const [mode] = useSetting(settings.ios.backdrop);
+  const [src, setSrc] = React.useState<string | null>(null);
+  const [layers, setLayers] = React.useState<{ id: number; soft: Soft }[]>(
+    []
+  );
+
+  React.useEffect(() => {
+    setSrc(null);
+    setLayers([]);
+    if (mode === 'off') return;
+    const decide = (): string | null => {
+      const item = document.querySelector<HTMLElement>(
+        "[data-ui='item-backdrop'][data-src]"
+      )?.dataset.src;
+      if (item) return item;
+      const all = document.querySelectorAll<HTMLImageElement>(HERO_PICTURE);
+      return pictureOf(all[all.length - 1]);
+    };
+    // A light look four times a second: the hero turns every several seconds, and pages change.
+    const look = () => {
+      // The hero's next and previous pictures, softened ahead, so the background turns with it.
+      for (const img of document.querySelectorAll<HTMLImageElement>(
+        "[data-ui='hero-backdrops'] img[data-ui='hero-backdrop']"
+      )) {
+        const next = pictureOf(img);
+        if (next) void soften(next);
+      }
+      const found = decide();
+      setSrc(found);
+      if (!found) setLayers((all) => (all.length ? [] : all));
+    };
+    look();
+    const timer = window.setInterval(look, 250);
+    return () => window.clearInterval(timer);
+  }, [mode]);
+
+  React.useEffect(() => {
+    if (!src) return;
+    let live = true;
+    void soften(src).then((soft) => {
+      if (!live || !soft) return;
+      setLayers((all) =>
+        all.at(-1)?.soft.url === soft.url
+          ? all
+          : [...all.slice(-1), { id: Date.now(), soft }]
+      );
+    });
+    return () => {
+      live = false;
+    };
+  }, [src]);
+
+  const shown = mode !== 'off' && layers.length > 0;
+  React.useEffect(() => {
+    document.documentElement.toggleAttribute('data-ios-backdrop', shown);
+    return () => document.documentElement.removeAttribute('data-ios-backdrop');
+  }, [shown]);
+
+  if (!shown) return null;
+  return (
+    <>
+      <TrailerFade soft={layers.at(-1)?.soft} />
+      {layers.map((layer) => (
+        <div
+          key={layer.id}
+          data-ui="ios-backdrop"
+          style={{ backgroundImage: `url(${JSON.stringify(layer.soft.url)})` }}
+        />
+      ))}
+    </>
+  );
+}
+
+/**
+ * The hero's bottom while its trailer plays. The trailer is the app's own video beneath the page,
+ * shown through a hole cut in the page's background, where no mask on the page can fade it. So the
+ * page paints over it: the background's own picture, lined up with where the background shows it
+ * and dimmed as it is, coming in over the hero's lower half (CSS shows it only while a trailer
+ * plays). It sits just after the hero's picture, so the hero's shading, text and buttons stay over it.
+ */
+function TrailerFade({ soft }: { soft: Soft | undefined }) {
+  React.useEffect(() => {
+    if (!soft) return;
+    let el: HTMLDivElement | null = null;
+    let frame = 0;
+    let last = '';
+    const tick = () => {
+      frame = requestAnimationFrame(tick);
+      try {
+        const still = document.querySelector<HTMLElement>(
+          "[data-ui='hero'] div:has(> [data-ui='hero-backdrops'])"
+        );
+        if (!still) {
+          el?.remove();
+          el = null;
+          return;
+        }
+        if (!el || el.previousElementSibling !== still) {
+          el?.remove();
+          el = document.createElement('div');
+          el.dataset.ui = 'ios-hero-fade';
+          el.setAttribute('aria-hidden', 'true');
+          still.after(el);
+          last = '';
+        }
+        const page = document.querySelector<HTMLElement>("[data-ui='page-background']");
+        if (!page) return;
+        const box = el.getBoundingClientRect();
+        const view = page.getBoundingClientRect();
+        // Where the background draws the picture: covering the screen, centred.
+        const scale = Math.max(view.width / soft.width, view.height / soft.height);
+        const w = soft.width * scale;
+        const h = soft.height * scale;
+        const x = view.left + (view.width - w) / 2 - box.left;
+        const y = view.top + (view.height - h) / 2 - box.top;
+        const at = `${w.toFixed(1)} ${h.toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`;
+        if (at === last) return;
+        last = at;
+        el.style.backgroundImage = `linear-gradient(rgba(8, 10, 16, 0.5), rgba(8, 10, 16, 0.5)), url(${JSON.stringify(soft.url)})`;
+        el.style.backgroundSize = `100% 100%, ${w}px ${h}px`;
+        el.style.backgroundPosition = `0 0, ${x}px ${y}px`;
+      } catch {
+        // A decoration: nothing drawn this frame.
+      }
+    };
+    frame = requestAnimationFrame(tick);
+    return () => {
+      cancelAnimationFrame(frame);
+      el?.remove();
+    };
+  }, [soft]);
+  return null;
+}
