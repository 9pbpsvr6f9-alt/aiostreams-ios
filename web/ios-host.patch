+import { settings } from '@/lib/settings';
+import { appBridge } from './bridge';
+
+export function iosFeedback(action: 'toggle' | 'seek' | 'track'): void {
+  const bridge = appBridge();
+  if (bridge?.platform === 'ios' && settings.ios.haptics.read())
+    bridge.send({ type: 'player-haptic', action });
+}
+
+/** A light tap as an item's menu opens, from a long press, a right click or its button. */
+export function iosMenuFeedback(): void {
+  const bridge = appBridge();
+  if (bridge?.platform === 'ios' && settings.ios.haptics.read())
+    bridge.send({ type: 'ui-haptic', action: 'menu' });
+}
+
+export const iosGesturesEnabled = () =>
+  appBridge()?.platform !== 'ios' || settings.ios.gestures.read();
diff --git a/packages/web/src/lib/hosts/shell/ios.ts b/packages/web/src/lib/hosts/shell/ios.ts
new file mode 100644
index 00000000..09ceb038
--- /dev/null
+++ b/packages/web/src/lib/hosts/shell/ios.ts
@@ -0,0 +1,122 @@
+import { settings, onSettingsChange } from '@/lib/settings';
+import type { Host } from '..';
+import { appBridge, ask } from './bridge';
+import { appEngine } from './player';
+import { resolveYouTube } from './youtube';
+import { shellDownloads } from './downloads';
+
+let fullscreen = false;
+
+/** Follows the iOS app's full screen, which hides the status bar and turns to landscape. */
+export function setupIos(): () => void {
+  const unsubscribe = appBridge()?.subscribe((m) => {
+    if (m.type === 'fullscreen') fullscreen = m.value;
+  });
+  const html = document.documentElement;
+  const apply = () => {
+    appBridge()?.send({
+      type: 'ios-player-settings',
+      haptics: settings.ios.haptics.read(),
+      automaticPip: settings.ios.automaticPip.read(),
+      gestures: settings.ios.gestures.read(),
+      launchLogo: settings.ios.launchLogo.read(),
+    });
+    // The parts of an unstarted episode the spoiler blur leaves clear (styles.css).
+    html.toggleAttribute('data-unblur-pictures', !settings.ios.spoilerPictures.read());
+    html.toggleAttribute('data-unblur-titles', !settings.ios.spoilerTitles.read());
+    html.toggleAttribute('data-unblur-descriptions', !settings.ios.spoilerDescriptions.read());
+  };
+  apply();
+  const stopSettings = onSettingsChange(apply);
+  // WebKit's back swipe shows the previous page's snapshot only for history entries that
+  // restore their own scroll; the router still restores it again once the page renders.
+  const restoreScroll = () => {
+    history.scrollRestoration = 'auto';
+  };
+  restoreScroll();
+  addEventListener('pageshow', restoreScroll);
+  // A selection tick for a menu's choice, the bottom bar's (or iPad rail's) tabs, a tapped
+  // poster, tile or episode, and the hero's buttons. The player's own menus send their own
+  // feedback (iosFeedback('track')). Only a tap clicks, so scrolling past cards stays quiet.
+  const TAPPABLE = [
+    '[role^="menuitem"]',
+    '[data-ui="mobile-nav-item"]',
+    '[data-ui="nav-item"]',
+    '[data-ui="poster-card"]',
+    '[data-ui="wide-card"]',
+    '[data-ui="media-row-item"]',
+    '[data-ui="episode-card"]',
+    '[data-ui="episode-list-item"]',
+    '[data-ui="person-card"]',
+    '[data-ui="calendar-entry"]',
+    '[data-ui="history-tile"]',
+    '[data-ui="playlist-entry"]',
+    '[data-ui="random-card"]',
+    '[data-ui="open-card"]',
+    '[data-ui="hero-action"]',
+  ].join(', ');
+  // One tick per press: a menu's trigger answers its touch-down, and its click may follow.
+  let ticked: { el: Element; at: number } | null = null;
+  const tick = (el: Element) => {
+    const now = performance.now();
+    if (ticked?.el === el && now - ticked.at < 600) return;
+    ticked = { el, at: now };
+    if (settings.ios.haptics.read())
+      appBridge()?.send({ type: 'ui-haptic', action: 'select' });
+  };
+  const tapped = (e: MouseEvent) => {
+    const target = e.target instanceof Element ? e.target : null;
+    const choice = target?.closest(TAPPABLE);
+    if (!choice || choice.closest('[data-ui="player-menu"]')) return;
+    tick(choice);
+  };
+  // A bar tab that opens a menu (the account's "You") opens it on touch-down, which takes the
+  // click away, so it ticks then. Only the bars' tabs: a card's touch-down may start a scroll.
+  const pressed = (e: PointerEvent) => {
+    const target = e.target instanceof Element ? e.target : null;
+    const tab = target?.closest(
+      ':is([data-ui="mobile-nav-item"], [data-ui="nav-item"])[aria-haspopup]'
+    );
+    if (tab) tick(tab);
+  };
+  document.addEventListener('click', tapped, true);
+  document.addEventListener('pointerdown', pressed, true);
+  return () => {
+    unsubscribe?.();
+    stopSettings();
+    removeEventListener('pageshow', restoreScroll);
+    document.removeEventListener('click', tapped, true);
+    document.removeEventListener('pointerdown', pressed, true);
+    for (const name of ['data-unblur-pictures', 'data-unblur-titles', 'data-unblur-descriptions'])
+      html.removeAttribute(name);
+  };
+}
+
+/** The iOS app: the page over AetherEngine, which draws the video beneath it. */
+export const iosHost: Host = {
+  name: 'ios-app',
+  device: () => ({ id: appBridge()?.deviceId, name: appBridge()?.device }),
+  player: appEngine,
+  // Upscaling: AetherEngine's super resolution, for Anime upscaling (iOS 26).
+  playerFeatures: ['audio', 'chapters', 'headers', 'upscaling'],
+  resolveYouTube,
+  // The app's queue, as the Android app's: background transfers that go on with the app closed.
+  downloads: shellDownloads,
+  levels: {
+    read: (level) => ask({ type: 'levels', level }, 'levels'),
+    set: (level, value) =>
