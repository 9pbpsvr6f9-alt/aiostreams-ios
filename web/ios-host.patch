+
+/** How far a picture's shape may stray from the frame's 16:9 before it sits inside it instead of filling it. */
+const FRAME_SLACK = 0.12;
+/** Narrower than this, a picture would blur stretched over the frame, so it sits inside it. */
+const FRAME_MIN_WIDTH = 360;
+
+/**
+ * iOS: a collection's picture (its wide card art, or else its poster) in place of its name on a phone,
+ * in the same 16:9 frame for every collection. A picture that doesn't fill the frame, being another
+ * shape or too small, sits whole in the middle over a blurred copy of itself. With no picture that
+ * loads, it goes, and the name shows.
+ */
+function CollectionPicture({
+  sources,
+  onGone,
+}: {
+  sources: string[];
+  onGone(): void;
+}) {
+  const [attempt, setAttempt] = React.useState(0);
+  const [fills, setFills] = React.useState(true);
+  const src = sources[attempt];
+  React.useEffect(() => {
+    if (!src) onGone();
+  }, [src, onGone]);
+  if (!src) return null;
+  return (
+    <div
+      data-ui="item-collection-picture"
+      aria-hidden
+      className="relative mx-auto aspect-video w-[80%] max-w-sm overflow-hidden rounded-2xl shadow-2xl ring-1 ring-white/10 md:hidden"
+    >
+      {!fills && (
+        <CachedImage
+          src={src}
+          alt=""
+          className="absolute inset-0 h-full w-full scale-125 object-cover opacity-80 blur-2xl saturate-150"
+        />
+      )}
+      <CachedImage
+        key={src}
+        src={src}
+        alt=""
+        onLoad={(e) => {
+          const img = e.currentTarget;
+          const shape = img.naturalWidth / Math.max(1, img.naturalHeight);
+          setFills(
+            Math.abs(shape - 16 / 9) <= FRAME_SLACK &&
+              img.naturalWidth >= FRAME_MIN_WIDTH
+          );
+        }}
+        onError={() => setAttempt((a) => a + 1)}
+        className={cn(
+          'relative h-full w-full',
+          fills ? 'object-cover' : 'object-contain'
+        )}
+      />
+    </div>
+  );
+}
