+import { settings } from '@/lib/settings';
+import { appBridge } from './bridge';
+
+export function iosFeedback(action: 'toggle' | 'seek' | 'track'): void {
+  const bridge = appBridge();
+  if (bridge?.platform === 'ios' && settings.ios.haptics.read())
+    bridge.send({ type: 'player-haptic', action });
+}
+
+export const iosGesturesEnabled = () =>
+  appBridge()?.platform !== 'ios' || settings.ios.gestures.read();
diff --git a/packages/web/src/lib/hosts/shell/ios.ts b/packages/web/src/lib/hosts/shell/ios.ts
new file mode 100644
index 0000000..bf0fef1
--- /dev/null
+++ b/packages/web/src/lib/hosts/shell/ios.ts
@@ -0,0 +1,52 @@
+import { settings, onSettingsChange } from '@/lib/settings';
+import type { Host } from '..';
+import { appBridge, ask } from './bridge';
+import { appEngine } from './player';
+import { resolveYouTube } from './youtube';
+
+let fullscreen = false;
+
+/** Follows the iOS app's full screen, which hides the status bar and turns to landscape. */
+export function setupIos(): () => void {
+  const unsubscribe = appBridge()?.subscribe((m) => {
+    if (m.type === 'fullscreen') fullscreen = m.value;
+  });
+  const apply = () =>
+    appBridge()?.send({
+      type: 'ios-player-settings',
+      haptics: settings.ios.haptics.read(),
+      gestures: settings.ios.gestures.read(),
+    });
+  apply();
+  const stopSettings = onSettingsChange(apply);
+  return () => {
+    unsubscribe?.();
+    stopSettings();
+  };
+}
+
+/** The iOS app: the page over AetherEngine, which draws the video beneath it. */
+export const iosHost: Host = {
+  name: 'ios-app',
+  device: () => ({ id: appBridge()?.deviceId, name: appBridge()?.device }),
+  player: appEngine,
+  playerFeatures: ['audio', 'chapters', 'headers'],
+  resolveYouTube,
+  levels: {
+    read: (level) => ask({ type: 'levels', level }, 'levels'),
+    set: (level, value) =>
+      appBridge()?.send({ type: 'set-level', level, value }),
+    release: () =>
+      appBridge()?.send({
+        type: 'set-level',
+        level: 'brightness',
+        value: null,
+      }),
+  },
+  fullscreen: {
+    active: () => fullscreen,
+    set: (on) => appBridge()?.send({ type: 'fullscreen', value: on }),
+  },
+  saveFile: (name, type, text) =>
+    appBridge()?.send({ type: 'save-file', name, mime: type, text }),
+};
