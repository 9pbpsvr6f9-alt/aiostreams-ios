+  document.addEventListener('pointerdown', pressed, true);
+  return () => {
+    unsubscribe?.();
+    stopSettings();
+    removeEventListener('pageshow', restoreScroll);
+    document.removeEventListener('click', tapped, true);
+    document.removeEventListener('pointerdown', pressed, true);
+    for (const name of ['data-unblur-pictures', 'data-unblur-titles', 'data-unblur-descriptions'])
