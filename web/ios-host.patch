+/* WKWebView history snapshots need a painted document canvas while browsing.
+   A hero or title trailer plays under the page and shows through its video
+   hole, as on Android, so the canvas stays clear there. Also covers startup. */
+html.see-through[data-host='ios-app']:not(.playing):not([data-video-hole]) {
+  background-color: var(--background, #000) !important;
+  color-scheme: dark;
+}
+
+/* On iOS, spoilers blur on a title's own episodes, not on Home's rows. Those rows (Next up,
+   Upcoming, Continue watching) exist only on Home; the upstream rule is more specific. */
+html[data-host='ios-app'][data-blur-spoilers]
+  :is([data-row='next-up'], [data-row='upcoming'], [data-row='resume'])
+  [data-ui='wide-card']
+  :is([data-ui='artwork'], [data-ui='wide-card-subtitle']) {
+  filter: none !important;
+}
+
+/* iOS: the parts of an unstarted episode the blur leaves clear, chosen per device
+   (Settings, Spoilers). Marked on the root by the iOS host. */
+html[data-host='ios-app'][data-unblur-pictures]
+  :is(
+    [data-ui='episode-card'],
+    [data-ui='episode-list-item'],
+    [data-ui='player-episode'],
+    [data-ui='calendar-entry'][data-episode],
+    [data-ui='calendar-day-art'][data-episode]
+  )
+  [data-ui='artwork'] {
+  filter: none !important;
+}
+html[data-host='ios-app'][data-unblur-titles]
