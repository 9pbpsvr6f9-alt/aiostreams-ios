+import { settings } from '@/lib/settings';
+import { appBridge } from './bridge';
+
+export function iosFeedback(action: 'toggle' | 'seek' | 'track'): void {
+  const bridge = appBridge();
+  if (bridge?.platform === 'ios' && settings.ios.haptics.read())
+    bridge.send({ type: 'player-haptic', action });
+}
+
+/** A light tap as an item's menu opens, from a long press, a right click or its button. */
+export function iosMenuFeedback(): void {
+  const bridge = appBridge();
+  if (bridge?.platform === 'ios' && settings.ios.haptics.read())
+    bridge.send({ type: 'ui-haptic', action: 'menu' });
+}
+
+export const iosGesturesEnabled = () =>
+  appBridge()?.platform !== 'ios' || settings.ios.gestures.read();
