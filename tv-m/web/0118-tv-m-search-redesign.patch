diff --git a/packages/web/src/styles.css b/packages/web/src/styles.css
index a16964b8..a0b8bd89 100644
--- a/packages/web/src/styles.css
+++ b/packages/web/src/styles.css
@@ -1090,3 +1090,34 @@ html[data-tv][data-tvm-backdrop] [data-ui='item-backdrop-shade'][data-name='side
 html[data-tv][data-tvm-backdrop] [data-ui='item-backdrop-shade'][data-name='bottom'] {
   background-image: linear-gradient(to top, rgb(8 10 16 / 0.5), rgb(8 10 16 / 0.2) 45%, transparent) !important;
 }
+
+/* ===== tv-m: Search, laid out as tvOS lays out its own =====
+   The keyboard sits at the top as the only search field; the page's title and field step aside while
+   it's up, and the results start just below it. With the keyboard down, the term shows in one glass
+   pill above the results, which opens the keyboard again. The keyboard offers the suggestions above
+   its keys, so the page no longer lists them. */
+html[data-tv] :has(> [data-ui='search-bar']) > [data-ui='page-title'] {
+  display: none;
+}
+html[data-tv][data-tv-keyboard] [data-ui='search-bar'] {
+  display: none;
+}
+html[data-tv][data-tv-keyboard] :has(> [data-ui='search-bar']) {
+  padding-top: 46vh !important;
+}
+html[data-tv] [data-ui='search-bar'] {
+  max-width: 32rem;
+  margin-top: 1rem;
+}
+html[data-tv] [data-ui='search-input'] {
+  border-radius: 9999px !important;
+  background: rgb(255 255 255 / 0.1) !important;
+  border: 1px solid rgb(255 255 255 / 0.14) !important;
+  box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.16) !important;
+}
+html[data-tv] [data-ui='search-input']:focus-visible,
+html[data-tv] :focus-visible > [data-ui='search-input'] {
+  background: rgb(236 236 240) !important;
+  color: rgb(18 18 22) !important;
+  outline: none !important;
+}
