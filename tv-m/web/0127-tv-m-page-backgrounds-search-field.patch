+  padding-top: 1.5rem !important;
+}
+html[data-tv] [data-ui='item-page'][data-type='BoxSet'] [data-ui='item-body'] > * + * {
+  margin-top: 1.5rem !important;
+}
+/* Search's field, with the keyboard down: wider and taller, and Liquid Glass under the remote, a
+   brighter tint with a bright rim, not solid white. */
