+  color: #fff !important;
+  border-color: rgb(255 255 255 / 0.75) !important;
+  box-shadow:
+    inset 0 1px 0 rgb(255 255 255 / 0.5),
+    0 0 0 2px rgb(255 255 255 / 0.55),
+    0 0 28px rgb(255 255 255 / 0.18) !important;
+}
