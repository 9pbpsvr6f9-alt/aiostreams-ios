+        r += data[p];
+        g += data[p + 1];
+        b += data[p + 2];
+      }
+      const n = radius * 2 + 1;
+      line[i * 3] = r / n;
+      line[i * 3 + 1] = g / n;
+      line[i * 3 + 2] = b / n;
+    }
+    for (let i = 0; i < length; i++) {
+      const p = at(i);
+      data[p] = line[i * 3];
+      data[p + 1] = line[i * 3 + 1];
+      data[p + 2] = line[i * 3 + 2];
+    }
+  }
