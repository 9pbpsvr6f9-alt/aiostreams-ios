+
+/* ===== tv-m: the frosted background without filters =====
+   The Apple TV app turns filters and masks off, so the picture comes already softened (a tiny,
+   box-blurred copy, stretched here), dimmed by a plain layer, and the hero fades into it through
+   a tall plain gradient in that same tint, ending where Continue watching begins. */
+[data-ui='tvm-backdrop'] {
+  inset: 0;
+  filter: none;
+  background-color: #0b0e16;
+}
+[data-ui='tvm-backdrop']::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: rgb(8 10 16 / 0.5);
+}
+html[data-tv][data-tvm-backdrop] [data-ui='hero-shade'][data-name='bottom'] {
+  display: block;
+  height: 75%;
+  background-image: linear-gradient(
+    to top,
+    rgb(8 10 16 / 0.5) 0%,
+    rgb(8 10 16 / 0.36) 28%,
+    rgb(8 10 16 / 0.14) 55%,
+    transparent 100%
+  ) !important;
