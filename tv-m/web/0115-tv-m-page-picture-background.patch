+
+/* A title's or collection's page under the frosted background, which softens the page's own picture.
+   Past a backdrop, the catalog picture's colour wash steps aside, so the softened picture fills the
+   screen; with a backdrop, its shading dims to black instead of the plain colour, as Home's hero's
+   does, so the art melts into its own frosted copy. */
+html[data-tv][data-tvm-backdrop] [data-ui='item-backdrop']:has([data-wash]) {
+  display: none;
+}
+html[data-tv][data-tvm-backdrop] [data-ui='item-backdrop-shade'][data-name='side'] {
+  background-image: linear-gradient(to right, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.25) 35%, transparent) !important;
+}
+html[data-tv][data-tvm-backdrop] [data-ui='item-backdrop-shade'][data-name='bottom'] {
+  background-image: linear-gradient(to top, rgb(8 10 16 / 0.5), rgb(8 10 16 / 0.2) 45%, transparent) !important;
+}
