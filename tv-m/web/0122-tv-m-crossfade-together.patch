diff --git a/packages/web/src/styles.css b/packages/web/src/styles.css
index 3a9fa32f..1ed49191 100644
--- a/packages/web/src/styles.css
+++ b/packages/web/src/styles.css
@@ -1118,3 +1118,30 @@ html[data-tv] :focus-visible > [data-ui='search-input'] {
   color: rgb(18 18 22) !important;
   outline: none !important;
 }
+
+/* A background layer, and its fade over the art, come in together once the layer's picture has
+   loaded; till then neither shows. The picture is an <img>, drawn as the layer's cover. */
+[data-ui='tvm-backdrop'] {
+  animation: none;
+  opacity: 0;
+}
+[data-ui='tvm-backdrop'][data-ready] {
+  animation: tvm-backdrop-in 0.9s ease-out both;
+  opacity: 1;
+}
+[data-ui='tvm-backdrop'] > img {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: center;
+}
+[data-ui='tvm-hero-fade'] > canvas {
+  animation: none;
+  opacity: 0;
+}
+[data-ui='tvm-hero-fade'] > canvas[data-ready] {
+  animation: tvm-backdrop-in 0.9s ease-out both;
+  opacity: 1;
+}
