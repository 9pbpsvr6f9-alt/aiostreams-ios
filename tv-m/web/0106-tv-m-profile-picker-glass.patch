diff --git a/packages/web/src/styles.css b/packages/web/src/styles.css
index bddb5ec4..a861a0e0 100644
--- a/packages/web/src/styles.css
+++ b/packages/web/src/styles.css
@@ -774,3 +774,60 @@ html[data-tv][data-tvm-hide-rail] [style*='--side-bar'] {
     transition: none;
   }
 }
+
+/* ===== tv-m: Liquid Glass on Who's watching ===== */
+/* Each face sits in a glass rim, with a gloss across its top. */
+html[data-tv] [data-ui='user-picker-user'] [data-focus-frame] {
+  box-shadow:
+    0 0 0 6px rgb(255 255 255 / 0.1),
+    0 0 0 7px rgb(255 255 255 / 0.24),
+    0 20px 44px -18px rgb(0 0 0 / 0.75);
+  transition: transform 0.25s ease-out, box-shadow 0.25s ease-out;
+}
+html[data-tv] [data-ui='user-picker-user'] [data-focus-frame]::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  border-radius: 9999px;
+  pointer-events: none;
+  background: linear-gradient(150deg, rgb(255 255 255 / 0.3) 0%, rgb(255 255 255 / 0.04) 42%, transparent 60%);
+  box-shadow:
+    inset 1.5px 1.5px 1px rgb(255 255 255 / 0.55),
+    inset -1px -1px 1px rgb(255 255 255 / 0.15);
+}
+/* A face without a picture: a frosted glass disc in place of the solid colour. */
+html[data-tv] [data-ui='user-picker-user'] [data-ui='avatar']:not(:has(img)) {
+  background: var(--tvg-sheen), rgb(255 255 255 / 0.12) !important;
+  -webkit-backdrop-filter: var(--tvg-filter);
+  backdrop-filter: var(--tvg-filter);
+}
+/* The remote's choice: a bright glass ring and a glow, in place of the outline. */
+html[data-tv] [data-ui='user-picker-user']:focus-visible [data-focus-frame] {
+  outline: none !important;
+  box-shadow:
+    0 0 0 6px rgb(255 255 255 / 0.32),
+    0 0 0 8px rgb(255 255 255 / 0.85),
+    0 0 44px rgb(255 255 255 / 0.32),
+    0 26px 52px -18px rgb(0 0 0 / 0.8);
+}
+html[data-tv] [data-ui='user-picker-user']:not(:focus-visible) span {
+  color: rgb(255 255 255 / 0.75);
+}
+/* Change server and its neighbours: glass pills, bright when focused. */
+html[data-tv] [data-ui='sign-in-links'] button {
+  background: var(--tvg-sheen), linear-gradient(var(--tvg-tint), var(--tvg-tint)), var(--tvg-shade) !important;
+  border: var(--tvg-border) !important;
+  -webkit-backdrop-filter: var(--tvg-filter);
+  backdrop-filter: var(--tvg-filter);
+  box-shadow: var(--tvg-edge), var(--tvg-drop) !important;
+  color: rgb(255 255 255 / 0.95) !important;
+  padding-inline: 1.5rem;
+  transition: transform 0.2s ease-out, box-shadow 0.2s ease-out, background 0.2s;
+}
+html[data-tv] [data-ui='sign-in-links'] button:focus-visible {
+  background: var(--tvg-sheen), linear-gradient(var(--tvg-focus), var(--tvg-focus)) !important;
+  color: rgb(0 0 0 / 0.9) !important;
+  outline: none !important;
+  box-shadow: var(--tvg-edge), var(--tvg-glow) !important;
+  transform: scale(1.08);
+}
