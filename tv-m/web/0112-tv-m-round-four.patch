+/** Steps in the hero's fade, and the share of its height the fade takes. */
+const FADE_STEPS = 24;
+const FADE_SHARE = 0.5;
+
+/**
+ * The hero's bottom half fading into the frosted background. The TV turns masks off, so the fade is
+ * drawn: strips of the background's own picture over the hero, each lined up with where the
+ * background shows it on the screen, and each a little more opaque than the one above it, the last
+ * fully so. The hero then ends in exactly what's below it, with no edge.
+ */
+function HeroFade({ layers }: { layers: { id: number; soft: Soft }[] }) {
+  const [hero, setHero] = React.useState<HTMLElement | null>(null);
+  const [height, setHeight] = React.useState(0);
+  const box = React.useRef<HTMLDivElement>(null);
+
+  React.useEffect(() => {
+    const look = () =>
+      setHero(
+        document.querySelector<HTMLElement>("[data-ui='hero']:not([data-loading])")
+      );
+    look();
+    const timer = window.setInterval(look, 500);
+    return () => window.clearInterval(timer);
+  }, []);
+
+  // Where the hero is on the screen, every frame: it scrolls and slides with the page.
+  React.useEffect(() => {
+    if (!hero) return;
+    let frame = 0;
+    let last = '';
+    const tick = () => {
+      const el = box.current;
+      if (el) {
+        const r = el.getBoundingClientRect();
+        const at = `${r.left.toFixed(1)} ${r.top.toFixed(1)}`;
+        if (at !== last) {
+          last = at;
+          el.style.setProperty('--x', `${r.left}px`);
+          el.style.setProperty('--y', `${r.top}px`);
+        }
+        const h = Math.round(r.height);
+        setHeight((was) => (was === h ? was : h));
+      }
+      frame = requestAnimationFrame(tick);
+    };
+    frame = requestAnimationFrame(tick);
+    return () => cancelAnimationFrame(frame);
+  }, [hero]);
+
+  if (!hero) return null;
+  const screenW = window.innerWidth;
+  const screenH = window.innerHeight;
+  const start = height * (1 - FADE_SHARE);
+  const edges = Array.from({ length: FADE_STEPS + 1 }, (_, i) =>
+    Math.round(start + ((height - start) * i) / FADE_STEPS)
+  );
+  return createPortal(
+    <div ref={box} data-ui="tvm-hero-fade" aria-hidden>
+      {height > 0 &&
+        layers.map(({ id, soft }) => {
+          // Laid out as the background lays it: covering the screen, centred.
+          const scale = Math.max(screenW / soft.width, screenH / soft.height);
+          const w = soft.width * scale;
+          const h = soft.height * scale;
+          const x = (screenW - w) / 2;
+          const y = (screenH - h) / 2;
+          return (
+            <div key={id}>
+              {edges.slice(0, -1).map((top, i) => (
+                <div
+                  key={i}
+                  style={{
+                    top,
+                    height: edges[i + 1] - top,
+                    opacity: (i + 1) / FADE_STEPS,
+                    backgroundImage: `linear-gradient(rgb(8 10 16 / 0.5), rgb(8 10 16 / 0.5)), url(${JSON.stringify(soft.url)})`,
+                    backgroundSize: `100% 100%, ${w}px ${h}px`,
+                    backgroundPosition: `0 0, calc(${x}px - var(--x)) calc(${y - top}px - var(--y))`,
+                  }}
+                />
+              ))}
+            </div>
+          );
+        })}
+    </div>,
+    hero
+  );
+}
