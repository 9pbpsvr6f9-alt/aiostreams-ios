   transform: scale(1.06);
 }
+
+/* ===== tv-m: round four ===== */
+/* Top tabs: the page you're on is bright text with a small dot beneath, not a capsule, so only the
+   tab the remote is on ever looks chosen. */
+html[data-tv] [data-ui='top-tabs'][data-style='pill'] [data-ui='nav-item'][aria-current='page']:not(:focus-visible) {
+  color: #fff !important;
+  font-weight: 600;
+  background: radial-gradient(circle at 50% calc(100% - 0.4rem), #fff 0.16rem, transparent 0.22rem) !important;
+  box-shadow: none !important;
+}
+
+/* The hero reaches the screen's left edge under the top tabs too, as it does beside the rail; its
+   text stays in line with the rows. */
+html[data-tv] [style*='--top-bar'] {
+  --side-bar: 2.5rem;
+}
+
+/* The hero's bottom fades into the frosted background: strips of that same picture, drawn over the
+   hero in rising steps (the TV turns masks off), with the hero's text and buttons above them. */
+[data-ui='tvm-hero-fade'] {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  z-index: 0;
+}
+[data-ui='tvm-hero-fade'] > div {
+  position: absolute;
+  inset: 0;
+  animation: tvm-backdrop-in 0.9s ease-out both;
+}
+[data-ui='tvm-hero-fade'] > div > div {
+  position: absolute;
+  inset-inline: 0;
+  background-repeat: no-repeat;
+}
+html[data-tv] [data-ui='hero'] :is([data-ui='hero-content'], [data-ui='hero-dots']) {
+  z-index: 1;
+}
+
+/* Only small controls get the glass focus pill. A panel, menu or list that takes focus itself, such
+   as the watch party sheet, keeps its own shape. */
+html[data-tv] .UI-Drawer__content {
+  border-radius: 1.75rem !important;
+}
+
+/* A row's title: room for the pill inside the box that cuts off long titles, and a pill drawn within
+   it, so no square edge cuts the glow off. */
+html[data-tv] [data-ui='media-row-title'] {
+  margin: -0.75rem;
+  padding: 0.75rem;
+}
+html[data-tv] [data-ui='media-row-title'] :focus-visible {
+  margin: -0.3rem -0.8rem;
+  padding: 0.3rem 0.8rem;
+  border-radius: 9999px;
+  background: linear-gradient(180deg, rgb(255 255 255 / 0.28), rgb(255 255 255 / 0.14)) !important;
+  box-shadow:
+    inset 0 1px 0 rgb(255 255 255 / 0.5),
+    inset 0 0 0 1px rgb(255 255 255 / 0.22) !important;
+}
