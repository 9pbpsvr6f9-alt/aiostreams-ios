   animation: tvm-backdrop-in 0.9s ease-out both;
   opacity: 1;
 }
+
+/* ===== tv-m: Home's hero meets the rows through a fixed grey =====
+   Matching the hero's edge to a background that changes left a line whenever it changed. Now the
+   hero's bottom fades into one fixed grey, solid at its edge, and the rows start in that same grey,
+   fading into the frosted background below. Both sides of the edge are always the same colour, and
+   both scroll with the page, so there is nothing to keep in step. */
+html[data-tv][data-tvm-backdrop] [data-ui='hero'] [data-ui='hero-shade'][data-name='bottom'] {
+  display: block;
+  height: 60% !important;
+  background-image: linear-gradient(
+    to top,
+    rgb(22 22 26) 0%,
+    rgb(22 22 26 / 0.85) 18%,
+    rgb(22 22 26 / 0.45) 50%,
+    transparent 100%
+  ) !important;
+}
+html[data-tv][data-tvm-backdrop] [data-ui='hero'] + [data-ui='home-rows']::before {
+  content: '';
+  position: absolute;
+  top: 0;
+  left: calc(-1 * var(--side-bar, 0px));
+  right: 0;
+  height: 32vh;
+  z-index: -1;
+  pointer-events: none;
+  background-image: linear-gradient(to bottom, rgb(22 22 26) 0%, rgb(22 22 26 / 0.6) 40%, transparent 100%);
+}
