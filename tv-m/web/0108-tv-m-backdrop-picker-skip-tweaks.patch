diff --git a/packages/web/src/components/shell/tvm-backdrop.tsx b/packages/web/src/components/shell/tvm-backdrop.tsx
new file mode 100644
index 00000000..68374552
--- /dev/null
+++ b/packages/web/src/components/shell/tvm-backdrop.tsx
@@ -0,0 +1,76 @@
+import React from 'react';
+import { settings, useSetting } from '@/lib/settings';
+
+/** The hero's slide on show, and its newest picture. */
+const HERO_PICTURE =
+  "[data-ui='hero-backdrops'] > [data-slide='0'] img[data-ui='hero-backdrop']";
+
+function pictureOf(img: HTMLImageElement | null | undefined): string | null {
+  return (img && (img.currentSrc || img.src)) || null;
+}
+
+/**
+ * tv-m: a frosted background behind the pages, drawn in the page background: the hero's picture
+ * (Settings > Interface > Background: Follow the hero), crossfading as the hero turns, or the
+ * picture of whatever the remote focuses (Follow the highlighted card), blurred and dimmed.
+ */
+export function TvmBackdrop() {
+  const [mode] = useSetting(settings.tvm.backdrop);
+  const [src, setSrc] = React.useState<string | null>(null);
+  const [layers, setLayers] = React.useState<{ id: number; src: string }[]>(
+    []
+  );
+
+  React.useEffect(() => {
+    setSrc(null);
+    if (mode === 'off') return;
+    if (mode === 'hero') {
+      // A light look once a second: the hero turns every several seconds.
+      const look = () => {
+        const all = document.querySelectorAll<HTMLImageElement>(HERO_PICTURE);
+        const found = pictureOf(all[all.length - 1]);
+        if (found) setSrc(found);
+      };
+      look();
+      const timer = window.setInterval(look, 1000);
+      return () => window.clearInterval(timer);
+    }
+    const onFocus = (e: FocusEvent) => {
+      const el = e.target;
+      if (!(el instanceof HTMLElement)) return;
+      const found = pictureOf(el.querySelector('img'));
+      if (found) setSrc(found);
+    };
+    document.addEventListener('focusin', onFocus);
+    return () => document.removeEventListener('focusin', onFocus);
+  }, [mode]);
+
+  React.useEffect(() => {
+    if (!src) return;
+    setLayers((all) =>
+      all.at(-1)?.src === src
+        ? all
+        : [...all.slice(-1), { id: Date.now(), src }]
+    );
+  }, [src]);
+
+  const shown = mode !== 'off' && layers.length > 0;
+  React.useEffect(() => {
+    document.documentElement.toggleAttribute('data-tvm-backdrop', shown);
+    return () =>
+      document.documentElement.removeAttribute('data-tvm-backdrop');
+  }, [shown]);
+
+  if (!shown) return null;
+  return (
+    <>
+      {layers.map((layer) => (
+        <div
+          key={layer.id}
+          data-ui="tvm-backdrop"
+          style={{ backgroundImage: `url(${JSON.stringify(layer.src)})` }}
+        />
+      ))}
+    </>
+  );
+}
