diff --git a/packages/web/src/styles.css b/packages/web/src/styles.css
index a861a0e0..8c21c3c7 100644
--- a/packages/web/src/styles.css
+++ b/packages/web/src/styles.css
@@ -831,3 +831,80 @@ html[data-tv] [data-ui='sign-in-links'] button:focus-visible {
   box-shadow: var(--tvg-edge), var(--tvg-glow) !important;
   transform: scale(1.08);
 }
+
+/* ===== tv-m: round three ===== */
+/* A smaller skip button: larger than the app's own, not by half again. */
+html[data-tv] [data-ui='skip-segment'] {
+  gap: 0.75rem !important;
+}
+html[data-tv] [data-ui='skip-segment'] button {
+  min-height: 3.25rem;
+  padding-inline: 1.4rem;
+  font-size: 1.2rem;
+}
+html[data-tv] [data-ui='skip-segment'] [data-name='keep-watching'] {
+  width: 3.25rem;
+  height: 3.25rem;
+  font-size: 1.4rem;
+}
+html[data-tv] [data-ui='skip-segment'] [data-name='countdown'] {
+  font-size: 1.05rem;
+}
+
+/* Who's watching: no rim on faces at rest, only a soft gloss and shadow; a thin bright ring and a
+   glow on the focused one; and a frosted aurora behind them, in place of the dark blue. */
+html[data-tv] [data-ui='user-picker-user'] [data-focus-frame] {
+  box-shadow: 0 18px 38px -20px rgb(0 0 0 / 0.7);
+}
+html[data-tv] [data-ui='user-picker-user'] [data-focus-frame]::after {
+  background: linear-gradient(150deg, rgb(255 255 255 / 0.18) 0%, transparent 40%);
+  box-shadow: inset 1px 1px 0.5px rgb(255 255 255 / 0.35);
+}
+html[data-tv] [data-ui='user-picker-user']:focus-visible [data-focus-frame] {
+  box-shadow:
+    0 0 0 3px rgb(255 255 255 / 0.92),
+    0 0 34px rgb(255 255 255 / 0.3),
+    0 24px 48px -18px rgb(0 0 0 / 0.75);
+}
+html[data-tv] [data-ui='sign-in-screen'] {
+  background:
+    radial-gradient(55% 50% at 78% 28%, rgb(255 150 90 / 0.42), transparent 70%),
+    radial-gradient(45% 45% at 62% 52%, rgb(236 72 153 / 0.3), transparent 70%),
+    radial-gradient(60% 55% at 90% 75%, rgb(59 130 246 / 0.4), transparent 72%),
+    radial-gradient(75% 70% at 15% 20%, rgb(56 78 160 / 0.55), transparent 75%),
+    linear-gradient(160deg, #0d1a33 0%, #1f3157 55%, #2c3854 100%) !important;
+}
+
+/* The frosted background (Settings > Interface > Background): a picture blurred and dimmed behind
+   the page, and the hero fading into it instead of into the plain colour. */
+[data-ui='tvm-backdrop'] {
+  position: absolute;
+  inset: -10%;
+  background-size: cover;
+  background-position: center;
+  filter: blur(64px) saturate(1.5) brightness(0.48);
+  animation: tvm-backdrop-in 0.9s ease-out both;
+}
+@keyframes tvm-backdrop-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+html[data-tv][data-tvm-backdrop] [data-ui='hero-shade'][data-name='side'] {
+  background-image: linear-gradient(to right, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.25) 35%, transparent) !important;
+}
+html[data-tv][data-tvm-backdrop] [data-ui='hero-shade'][data-name='bottom'] {
+  display: none;
+}
+html[data-tv][data-tvm-backdrop] [data-ui='hero-backdrops'] {
+  -webkit-mask-image: linear-gradient(to top, transparent, black 45%);
+  mask-image: linear-gradient(to top, transparent, black 45%);
+}
+@media (prefers-reduced-motion: reduce) {
+  [data-ui='tvm-backdrop'] {
+    animation: none;
+  }
+}
