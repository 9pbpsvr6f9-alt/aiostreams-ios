diff --git a/packages/web/src/styles.css b/packages/web/src/styles.css
index 1d5b5dfa..4aaab17a 100644
--- a/packages/web/src/styles.css
+++ b/packages/web/src/styles.css
@@ -935,3 +935,52 @@ html[data-tv][data-tvm-backdrop] [data-ui='hero-shade'][data-name='bottom'] {
     transparent 100%
   ) !important;
 }
+
+/* ===== tv-m: Liquid Glass top tabs (Navigation > Style: Top tabs, Top bar: Floating pills) =====
+   The TV turns blur off, so the glass is drawn: a neutral dark tint in place of the brand colour,
+   a top-lit sheen, a bright rim along the top edge and a fainter one below, and a soft shadow. */
+html[data-tv] [data-ui='top-tabs'][data-style='pill'] .bar-surface {
+  background:
+    linear-gradient(
+      180deg,
+      rgb(255 255 255 / 0.2) 0%,
+      rgb(255 255 255 / 0.06) 42%,
+      rgb(255 255 255 / 0.02) 58%,
+      rgb(255 255 255 / 0.08) 100%
+    ),
+    rgb(20 22 30 / 0.5) !important;
+  border: 1px solid rgb(255 255 255 / 0.2) !important;
+  box-shadow:
+    inset 0 1.5px 0 rgb(255 255 255 / 0.42),
+    inset 0 -1px 0 rgb(255 255 255 / 0.1),
+    0 2px 6px rgb(0 0 0 / 0.22),
+    0 20px 44px -18px rgb(0 0 0 / 0.75) !important;
+}
+html[data-tv] [data-ui='top-tabs'][data-style='pill'] [data-ui='nav-item'] {
+  color: rgb(255 255 255 / 0.84) !important;
+  background: transparent !important;
+  border-radius: 9999px !important;
+  transition: transform 0.2s ease-out, background 0.2s ease-out, box-shadow 0.2s ease-out, color 0.2s;
+}
+/* The page you're on: a clear glass capsule. */
+html[data-tv] [data-ui='top-tabs'][data-style='pill'] [data-ui='nav-item'][aria-current='page']:not(:focus-visible) {
+  color: #fff !important;
+  background:
+    linear-gradient(180deg, rgb(255 255 255 / 0.26), rgb(255 255 255 / 0.1)) !important;
+  box-shadow:
+    inset 0 1px 0 rgb(255 255 255 / 0.45),
+    inset 0 0 0 1px rgb(255 255 255 / 0.14) !important;
+}
+/* The remote's choice: bright white glass, dark text, a glow and a lift. */
+html[data-tv] [data-ui='top-tabs'][data-style='pill'] [data-ui='nav-item']:focus-visible {
+  color: rgb(10 12 18 / 0.92) !important;
+  background:
+    linear-gradient(180deg, rgb(255 255 255 / 1), rgb(232 236 245 / 0.94)) !important;
+  outline: none !important;
+  box-shadow:
+    inset 0 1px 0 rgb(255 255 255 / 1),
+    0 0 0 1px rgb(255 255 255 / 0.6),
+    0 0 26px rgb(255 255 255 / 0.32),
+    0 10px 24px -8px rgb(0 0 0 / 0.6) !important;
+  transform: scale(1.06);
+}
