diff --git a/packages/web/src/styles.css b/packages/web/src/styles.css
index d7f2e99e..bddb5ec4 100644
--- a/packages/web/src/styles.css
+++ b/packages/web/src/styles.css
@@ -678,3 +678,99 @@ html[data-tv] [data-ui='player-menu-item']:focus-visible {
     transform: none !important;
   }
 }
+
+/* ===== tv-m: a larger skip button, seen from across the room ===== */
+html[data-tv] [data-ui='skip-segment'] {
+  gap: 1rem !important;
+}
+html[data-tv] [data-ui='skip-segment'] button {
+  min-height: 4.25rem;
+  padding-inline: 2rem;
+  font-size: 1.6rem;
+}
+html[data-tv] [data-ui='skip-segment'] [data-name='keep-watching'] {
+  width: 4.25rem;
+  height: 4.25rem;
+  padding: 0;
+  font-size: 1.9rem;
+}
+html[data-tv] [data-ui='skip-segment'] [data-name='countdown'] {
+  min-width: 1.8em;
+  font-size: 1.3rem;
+}
+
+/* ===== tv-m: a glass pill, in place of the plain outline, on whatever else the remote focuses,
+   such as a row's title. A ring of the same tint stands in for padding, so nothing moves. Cards
+   keep their own ring round the picture. ===== */
+html[data-tv]
+  :focus-visible:not([data-focus='own']):not(input):not(textarea):not(#root):not(body):not(
+    :is(
+      [data-ui='player-middle-button'],
+      [data-ui='skip-segment'] button,
+      [data-ui='hero-action'],
+      [data-ui='item-action'],
+      [data-ui='season-pill'],
+      [data-ui='pill-tab'],
+      [data-ui='genre-pill'],
+      [data-ui='item-genre'],
+      [data-ui='player-button'],
+      [data-ui='player-menu-item'],
+      [data-ui='nav-item']
+    )
+  ) {
+  outline: none !important;
+  border-radius: 9999px;
+  background-color: rgb(255 255 255 / 0.16) !important;
+  color: #fff;
+  box-shadow:
+    0 0 0 0.55rem rgb(255 255 255 / 0.16),
+    0 0 0 calc(0.55rem + 1px) rgb(255 255 255 / 0.4),
+    inset 1px 1px 0.5px rgb(255 255 255 / 0.35),
+    0 16px 40px -14px rgb(0 0 0 / 0.65),
+    0 0 30px rgb(255 255 255 / 0.16) !important;
+  transition: background-color 0.2s, box-shadow 0.2s;
+}
+
+/* ===== tv-m: the floating rail as a glass panel ===== */
+html[data-tv] [data-ui='tv-rail'][data-shape='floating'] .bar-surface {
+  background: var(--tvg-sheen), var(--tvg-panel) !important;
+  border: var(--tvg-border) !important;
+  -webkit-backdrop-filter: var(--tvg-panel-filter) !important;
+  backdrop-filter: var(--tvg-panel-filter) !important;
+  box-shadow: var(--tvg-edge), var(--tvg-drop) !important;
+}
+/* The current page: a quiet glass capsule. */
+html[data-tv] [data-ui='tv-rail'] [data-ui='nav-item'][aria-current='page']:not(:focus-visible) {
+  background: rgb(255 255 255 / 0.14) !important;
+  border-radius: 9999px !important;
+  box-shadow: inset 1px 1px 0.5px rgb(255 255 255 / 0.3);
+  color: #fff !important;
+}
+/* The remote's choice: bright glass with dark text. */
+html[data-tv] [data-ui='tv-rail'] [data-ui='nav-item']:focus-visible {
+  background: var(--tvg-sheen), linear-gradient(var(--tvg-focus), var(--tvg-focus)) !important;
+  border-radius: 9999px !important;
+  color: rgb(0 0 0 / 0.9) !important;
+  outline: none !important;
+  box-shadow: var(--tvg-edge), var(--tvg-glow) !important;
+}
+
+/* ===== tv-m: Settings > Interface > Hide the rail while browsing =====
+   The floating rail slides off the edge while the page has focus, and back in when it takes it
+   (left at the edge, or Back). The page keeps only a small margin for it. */
+html[data-tv][data-tvm-hide-rail] [data-ui='tv-rail'][data-shape='floating'] .bar-surface {
+  transition:
+    transform 0.32s cubic-bezier(0.2, 0.7, 0.2, 1),
+    width 0.2s;
+}
+html[data-tv][data-tvm-hide-rail] [data-ui='tv-rail'][data-shape='floating']:not(:focus-within) .bar-surface {
+  transform: translateX(calc(-100% - 3rem));
+}
+html[data-tv][data-tvm-hide-rail] [style*='--side-bar'] {
+  --side-bar: 3rem !important;
+}
+@media (prefers-reduced-motion: reduce) {
+  html[data-tv][data-tvm-hide-rail] [data-ui='tv-rail'][data-shape='floating'] .bar-surface {
+    transition: none;
+  }
+}
