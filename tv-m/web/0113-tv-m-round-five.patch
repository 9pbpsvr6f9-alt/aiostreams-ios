+/* ===== tv-m: round five ===== */
+/* Top tabs as tvOS draws them: one evenly tinted capsule with a thin rim; the tab the remote is on
+   solid white with dark text; the page you're on a soft grey capsule with white text. */
+html[data-tv] [data-ui='top-tabs'][data-style='pill'] .bar-surface {
+  background: rgb(22 22 26 / 0.46) !important;
+  border: 1px solid rgb(255 255 255 / 0.1) !important;
+  box-shadow:
+    inset 0 1px 0 rgb(255 255 255 / 0.14),
+    0 12px 32px -16px rgb(0 0 0 / 0.6) !important;
+}
+html[data-tv] [data-ui='top-tabs'][data-style='pill'] [data-ui='nav-item'] {
+  color: rgb(255 255 255 / 0.92) !important;
+  font-weight: 600;
+}
+html[data-tv] [data-ui='top-tabs'][data-style='pill'] [data-ui='nav-item'][aria-current='page']:not(:focus-visible) {
+  color: #fff !important;
+  background: rgb(255 255 255 / 0.2) !important;
+  box-shadow: none !important;
+}
+html[data-tv] [data-ui='top-tabs'][data-style='pill'] [data-ui='nav-item']:focus-visible {
+  color: rgb(18 18 22) !important;
+  background: rgb(236 236 240) !important;
+  box-shadow: 0 8px 22px -8px rgb(0 0 0 / 0.55) !important;
+  transform: scale(1.04);
+}
+
+/* A row's title (Streaming Services, Genres): the title's own box is the pill, with its glass drawn
+   inside it, so nothing past its edges is cut off. Room at the sides comes from its margins; above
+   and below, from a little extra height. */
 html[data-tv] [data-ui='media-row-title'] {
-  margin: -0.75rem;
-  padding: 0.75rem;
+  margin: 0 -1rem;
+  padding: 0.35rem 1rem;
+  border-radius: 9999px;
+  transition: background 0.2s, box-shadow 0.2s;
+}
+html[data-tv] [data-ui='media-row-title']:is(:focus-visible, :has(:focus-visible)) {
+  outline: none !important;
+  background: rgb(255 255 255 / 0.18) !important;
+  box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.85), inset 0 1px 0 rgb(255 255 255 / 0.3) !important;
 }
 html[data-tv] [data-ui='media-row-title'] :focus-visible {
-  margin: -0.3rem -0.8rem;
-  padding: 0.3rem 0.8rem;
-  border-radius: 9999px;
-  background: linear-gradient(180deg, rgb(255 255 255 / 0.28), rgb(255 255 255 / 0.14)) !important;
-  box-shadow:
-    inset 0 1px 0 rgb(255 255 255 / 0.5),
-    inset 0 0 0 1px rgb(255 255 255 / 0.22) !important;
+  outline: none !important;
+  background: none !important;
+  box-shadow: none !important;
+}
+
+/* A shorter hero on the TV, so the first row's cards show at the bottom of the screen, as a peek of
+   what's below. Its height was set in rem, which the TV enlarges, so it filled nearly the screen. */
